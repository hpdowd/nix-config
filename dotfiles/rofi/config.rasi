/* rofi's configuration and its layout rules.
 *
 * rofi reads ~/.config/rofi/config.rasi and nothing in the mango tree points at
 * it, so modules/home/dotfiles.nix declaring this path is the only thing that
 * connects the two (docs/adr/0014). Declared as a FILE, not a directory: rofi
 * writes a cache and rofi.png next to it.
 *
 * The COLOURS are not here. `colors.rasi` next to this file is generated from
 * modules/home/palette.nix, the same palette the terminals and the bar use, so
 * `@accent` here and `@accent` in waybar/colors.css cannot drift apart. Change
 * a colour there and rebuild; change the shape below by hand.
 */

configuration {
  /* Only the modes something actually reaches. `calc` and `emoji` come from
   * the two plugins in modules/system/desktop.nix; naming a mode whose plugin
   * is not built makes `rofi -show calc` print "Mode calc is not found" to a
   * stderr nobody is reading and exit 1 — a key that does nothing. The list
   * here and the plugin list there are held together by checks/static.sh. */
  modes: "drun,run,calc,emoji";

  /* Menu entries carry Font Awesome glyphs ( and friends) in the string
   * itself, so this must be a Nerd Font or every icon renders as a box.
   * "Hack Nerd Font" is declared in modules/system/fonts.nix and is the
   * terminal font; checks/static.sh resolves this name against the built font
   * closure, because a family that matches nothing falls back silently. */
  font: "Hack Nerd Font 11";

  /* The glyphs are already in the text; icon lookup would add a per-entry
   * theme scan for nothing. drun is the exception and is not on a key. */
  show-icons: false;
  drun-display-format: "{name}";

  calc {
    /* Without this, Enter on a result does nothing: rofi-calc writes the
     * result to stdout, and a rofi spawned from a keybind has no stdout
     * anyone reads. The plugin runs this through `/bin/sh -c` — which does
     * exist on NixOS, unlike /bin/bash. */
    calc-command: "echo -n '{result}' | wl-copy";
  }
}

@import "colors"

/* ==========================================================================
   Shape.

   The system's design language, and none of it is invented here — it is read
   off what already exists:

     tiling.conf   borderpx=1, border_radius=0, bordercolor=0x3c3836,
                   focuscolor=0xd79921, gaps 0
     style-solid.css   border-radius: 0, `border: none` with 1px @overlay
                   hairlines, flat transparent modules, and selection drawn as
                   `background: @accent; color: @base` on the active workspace

   So: square, 1px, flat, one accent, no zebra striping. rofi's own shipped
   gruvbox-dark disagreed with all four — 2px borders, an #a89984 border that
   matches nothing here, #665c54 selection where the terminals use #504945, and
   alternate rows striped #32302f. It is a different gruvbox, not this one.
   ========================================================================== */

/* Map rofi's ROLE names onto the palette, rather than styling widgets one by
 * one. This is not stylistic — a widget with no rule of its own still resolves
 * through these, and rofi's built-in defaults are **Solarized light**
 * (`background: #fdf6e3`, `foreground: #002b36`). Styling only the widgets you
 * can name leaves the rest cream-on-teal, and you find out the first time a
 * menu marks a row urgent. `rofi -dump-theme` is the check: nothing in the
 * output should still read `var(lightbg)`, `var(blue)` or `var(red)`.
 *
 * The `alternate-*` roles are deliberately identical to their `normal-*`
 * counterparts. That is what turns off zebra striping, which rofi's shipped
 * gruvbox does and nothing else on this system does. */
* {
  background:                  @base;
  background-color:            transparent;
  foreground:                  @text;
  border-color:                @overlay;
  separatorcolor:              @overlay;
  scrollbar-handle:            @overlay;
  text-color:                  @text;

  normal-background:           transparent;
  normal-foreground:           @text;
  alternate-normal-background: transparent;
  alternate-normal-foreground: @text;
  selected-normal-background:  @accent;
  selected-normal-foreground:  @base;

  active-background:           transparent;
  active-foreground:           @accent;
  alternate-active-background: transparent;
  alternate-active-foreground: @accent;
  selected-active-background:  @accent;
  selected-active-foreground:  @base;

  urgent-background:           transparent;
  urgent-foreground:           @urgent;
  alternate-urgent-background: transparent;
  alternate-urgent-foreground: @urgent;
  selected-urgent-background:  @urgent;
  selected-urgent-foreground:  @base;

  /* Matched substring. Bold only: italic in a mono Nerd Font reflows the
   * glyph advance, so the icon column visibly shifts as you type. */
  highlight:                   bold;
}

window {
  background-color: @base;
  border:           1px;
  border-color:     @overlay;
  border-radius:    0;
  padding:          0;
  width:            40em;
}

/* No `children` list. Setting one is how the live calc preview was lost on
 * 2026-08-14: rofi's default is [ inputbar, message, listview, mode-switcher ],
 * this said [ inputbar, listview ], and rofi-calc renders its running result
 * through the mode `_get_message` hook — which `rofi_view_reload_message_bar`
 * (view.c:208) drops on the floor when `mesg_box` is NULL, i.e. whenever
 * `message` is not in the layout. Nothing logged; Enter still worked, because
 * `calc-command` runs off the entry rather than the message. Pinning this list
 * opts out of every widget rofi adds, present and future, to reorder nothing —
 * the default order is already the wanted one. */
mainbox {
  border:  0;
  padding: 0;
}

/* One hairline under the input, in the bar's separator colour — the same rule
 * `window#waybar` uses to divide itself from the windows below it. */
inputbar {
  padding:      6px 10px;
  spacing:      8px;
  border:       0 0 1px 0;
  border-color: @overlay;
  children:     [ prompt, entry ];
}

prompt {
  text-color: @accent;
}

entry {
  text-color:        @text;
  placeholder-color: @subtext;
  /* rofi's default is the literal "Type to filter". Every caller already
   * passes `-p`, so that would be a second label saying less. */
  placeholder:       "";
}

listview {
  /* `lines` is a ceiling, not a height: `dynamic` shrinks the list to its
   * contents, so a three-item menu is three items tall on its own. This is
   * what replaced the --maxheight every walker call had to carry and re-guess
   * whenever a menu grew an entry. */
  lines:     12;
  dynamic:   true;
  scrollbar: false;
  border:    0;
  padding:   4px 0;
  spacing:   0;
}

/* Flat, like the bar's modules: no per-row background, generous horizontal
 * padding, tight vertical. The separator rows the menus draw ("──────") are
 * ordinary entries, so anything with a background here would box them too. */
element {
  padding: 4px 10px;
  border:  0;
}

/* No per-state `element` rules: the roles above already carry all nine
 * combinations, and repeating them here is how the two drift. Selection comes
 * out as the accent block, exactly as `#workspaces button.active` draws the
 * focused workspace on the bar. */

element-text,
element-icon {
  background-color: inherit;
  text-color:       inherit;
  vertical-align:   0.5;
}

/* `-mesg` is unused today, but an unstyled widget inherits rofi's built-in
 * theme rather than nothing — so it would appear in a colour scheme this file
 * has otherwise replaced, the first time some script passes one. */
message {
  padding:      6px 10px;
  border:       0 0 1px 0;
  border-color: @overlay;
}

textbox {
  text-color: @subtext;
}

/* The match counter. Not in `inputbar`'s children, so it does not draw today —
 * but rofi hardcodes these three to a literal `Gray` rather than resolving a
 * role, so they are the one place the sweep above cannot reach. Named here so
 * adding them to the inputbar later is a one-line change, not a surprise. */
num-filtered-rows,
num-rows,
textbox-num-sep {
  text-color: @subtext;
}

/* `no-custom` is NOT set here, deliberately. It belongs at the call site:
 * every fixed-choice menu passes `-no-custom` so a typo cannot return itself
 * and fall silently through the handler's `*)` branch, while the password
 * prompt in menus/network-menu.sh must NOT pass it — there the typed string
 * is the answer. Setting it globally would need un-setting for that one call,
 * and rofi has no negation for it: `-no-no-custom` is accepted, ignored, and
 * exits 0.
 */
