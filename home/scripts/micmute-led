#!/usr/bin/env bash
# Syncs the ThinkPad mic-mute LED with the actual PipeWire default source mute state.
# Runs as a daemon — subscribe to PipeWire events and update on any source change.

LED=/sys/class/leds/platform::micmute/brightness

update_led() {
    local state
    state=$(pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null)
    case "$state" in
        *yes*) echo 1 > "$LED" ;;
        *no*)  echo 0 > "$LED" ;;
    esac
}

update_led

pactl subscribe | while read -r line; do
    case "$line" in
        *"change"*"source"*) update_led ;;
        *"change"*"server"*) update_led ;;
    esac
done
